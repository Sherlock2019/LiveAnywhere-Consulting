generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  MANAGER
  PARTNER
  ADMIN
}

enum CaseStatus {
  LEAD
  ASSESSING
  PLANNING
  ACTIVE
  ARRIVED
  SETTLED
  CLOSED
}

enum VisaStatus {
  ACTIVE
  TEMPORARY
  PROPOSED
  SUSPENDED
  CLOSED
  REQUIRES_REVIEW
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum DocumentStatus {
  NEEDED
  REQUESTED
  RECEIVED
  VERIFIED
  EXPIRED
}

enum SponsorshipStatus {
  YES
  NO
  POSSIBLE
  UNKNOWN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
  households    Household[]
  cases         RelocationCase[] @relation("CaseCustomer")
  managedCases  RelocationCase[] @relation("CaseManager")
  appointments  Appointment[]
  messages      Message[]
  notifications Notification[]
  savedProperties SavedProperty[]
  applications  JobApplication[]
  orders        ServiceOrder[]
  payments      Payment[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]     @relation("AuditActor")
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  phone         String?
  locale        String   @default("en")
  nationality   String?
  currentCity   String?
  currentCountry String?
  profession    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Household {
  id          String   @id @default(cuid())
  userId      String
  label       String   @default("My household")
  adults      Int      @default(1)
  children    Int      @default(0)
  pets        Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases       RelocationCase[]
}

model Country {
  id          String   @id
  name        String
  iso2        String   @unique
  flag        String
  launch      Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cities      City[]
  destinationCases RelocationCase[] @relation("DestinationCountry")
  originCases RelocationCase[] @relation("OriginCountry")
  visaRoutes  VisaRoute[]
  properties  Property[]
  jobs        Job[]
  partners    Partner[]
}

model City {
  id          String   @id
  countryId   String
  name        String
  slug        String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  costOfLiving Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  properties  Property[]
  jobs        Job[]
  @@unique([countryId, slug])
}

model RelocationCase {
  id                String      @id @default(cuid())
  customerId        String
  managerId         String?
  householdId       String?
  originCountryId   String
  destinationCountryId String
  originCity        String?
  destinationCity   String?
  goals             String[]
  targetMoveDate    DateTime?
  intendedStay      String?
  monthlyBudget     Decimal?    @db.Decimal(12, 2)
  relocationBudget  Decimal?    @db.Decimal(14, 2)
  readinessScore    Int?
  status            CaseStatus  @default(LEAD)
  consentedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customer          User        @relation("CaseCustomer", fields: [customerId], references: [id])
  manager           User?       @relation("CaseManager", fields: [managerId], references: [id])
  household         Household?  @relation(fields: [householdId], references: [id])
  originCountry     Country     @relation("OriginCountry", fields: [originCountryId], references: [id])
  destinationCountry Country    @relation("DestinationCountry", fields: [destinationCountryId], references: [id])
  assessments       Assessment[]
  recommendations   Recommendation[]
  tasks             Task[]
  documents         Document[]
  appointments      Appointment[]
  savedProperties   SavedProperty[]
  applications      JobApplication[]
  orders            ServiceOrder[]
  quotes            Quote[]
  messages          Message[]
  payments          Payment[]
  auditLogs         AuditLog[]
  @@index([customerId, status])
}

model VisaRoute {
  id              String      @id
  destinationCountryId String
  routeName       String
  routeCode       String
  category        String
  purposes        String[]
  originCountries String[]
  status          VisaStatus
  publicStatus    String
  summary         String
  lastVerified    DateTime
  rules           VisaRule[]
  sources         VisaSource[]
  country         Country     @relation(fields: [destinationCountryId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([destinationCountryId, status])
}

model VisaRule {
  id          String   @id @default(cuid())
  visaRouteId String
  key         String
  operator    String
  value       Json
  outcome     Json
  priority    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  route       VisaRoute @relation(fields: [visaRouteId], references: [id], onDelete: Cascade)
  @@index([visaRouteId, active])
}

model VisaSource {
  id          String   @id @default(cuid())
  visaRouteId String
  label       String
  url         String
  publisher   String?
  verifiedAt  DateTime
  archivedUrl String?
  route       VisaRoute @relation(fields: [visaRouteId], references: [id], onDelete: Cascade)
}

model Assessment {
  id          String   @id @default(cuid())
  caseId      String
  answers     Json
  score       Int?
  breakdown   Json?
  version     String
  createdAt   DateTime @default(now())
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String   @id @default(cuid())
  caseId      String
  type        String
  title       String
  summary     String
  status      String
  rationale   Json?
  sourceData  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(cuid())
  caseId      String
  title       String
  category    String
  status      TaskStatus @default(NOT_STARTED)
  dueAt       DateTime?
  completedAt DateTime?
  sortOrder   Int        @default(0)
  metadata    Json?
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId, status])
}

model Document {
  id          String         @id @default(cuid())
  caseId      String
  name        String
  category    String
  status      DocumentStatus @default(NEEDED)
  storageKey  String?
  mimeType    String?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String   @id @default(cuid())
  caseId      String
  userId      String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  channel     String
  status      String
  meetingUrl  String?
  createdAt   DateTime @default(now())
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model Property {
  id          String   @id
  countryId   String
  cityId      String
  title       String
  neighborhood String
  monthlyRent Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  bedrooms    Int
  furnished   Boolean
  petsAllowed Boolean?
  propertyType String
  status      String
  mock        Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     Country  @relation(fields: [countryId], references: [id])
  city        City     @relation(fields: [cityId], references: [id])
  saves       SavedProperty[]
}

model SavedProperty {
  id          String   @id @default(cuid())
  userId      String
  caseId      String
  propertyId  String
  notes       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id])
  @@unique([userId, caseId, propertyId])
}

model Job {
  id          String   @id
  countryId   String
  cityId      String?
  title       String
  company     String
  profession  String
  industry    String
  salaryText  String?
  workMode    String
  sponsorship SponsorshipStatus @default(UNKNOWN)
  status      String
  mock        Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     Country  @relation(fields: [countryId], references: [id])
  city        City?    @relation(fields: [cityId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  userId      String
  caseId      String
  jobId       String
  status      String
  notes       String?
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id])
  @@unique([userId, jobId])
}

model Partner {
  id          String   @id @default(cuid())
  countryId   String
  name        String
  verified    Boolean  @default(false)
  languages   String[]
  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int      @default(0)
  responseTime String?
  mock        Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     Country  @relation(fields: [countryId], references: [id])
  services    PartnerService[]
  quotes      Quote[]
}

model Service {
  id          String   @id
  name        String
  category    String
  description String
  active      Boolean  @default(true)
  pricing     Json?
  partnerServices PartnerService[]
  orders      ServiceOrder[]
}

model PartnerService {
  id          String   @id @default(cuid())
  partnerId   String
  serviceId   String
  countries   String[]
  priceFrom   Decimal? @db.Decimal(12, 2)
  currency    String?  @default("USD")
  active      Boolean  @default(true)
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([partnerId, serviceId])
}

model ServiceOrder {
  id          String   @id @default(cuid())
  userId      String
  caseId      String
  serviceId   String
  status      String
  amount      Decimal? @db.Decimal(12, 2)
  currency    String   @default("USD")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id])
  quotes      Quote[]
}

model Quote {
  id          String   @id @default(cuid())
  caseId      String
  partnerId   String
  orderId     String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  status      String
  expiresAt   DateTime?
  details     Json?
  createdAt   DateTime @default(now())
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  partner     Partner @relation(fields: [partnerId], references: [id])
  order       ServiceOrder? @relation(fields: [orderId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  caseId      String
  senderId    String
  body        String
  channel     String   @default("dashboard")
  readAt      DateTime?
  createdAt   DateTime @default(now())
  case        RelocationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  caseId      String?
  provider    String
  providerRef String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  case        RelocationCase? @relation(fields: [caseId], references: [id])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  plan        String
  status      String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  renewsAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  caseId      String?
  entityType  String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  officialSource String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  case        RelocationCase? @relation(fields: [caseId], references: [id])
  @@index([entityType, entityId, createdAt])
}

model PricingPlan {
  id          String   @id
  name        String
  priceText   String
  amount      Decimal? @db.Decimal(12, 2)
  currency    String   @default("USD")
  features    String[]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  email       String?
  origin      String
  destination String
  goal        String
  timeframe   String?
  budgetBand  String?
  householdSize Int
  complexity  String?
  services    String[]
  score       Int      @default(0)
  consentedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([score, createdAt])
}
